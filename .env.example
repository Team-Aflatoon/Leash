# Copy to .env for local runs (never commit .env).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/leash
PORT=8080
PUBLIC_URL=http://localhost:8080
DEMO_MODE=true
APPROVAL_TIMEOUT_SECONDS=600
# 32-byte hex or any long random string. Keep it stable: ledger checkpoints are signed with it.
GATEWAY_SIGNING_KEY=
# Bearer token the agent process uses. Generated per boot if empty.
AGENT_TOKEN=
# PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox). Vault must be enabled on the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# LLM (intent check, mandate drafting, live agent). Optional: without one, the rules still decide everything.
# LLM_PROVIDER=gemini|anthropic (default: gemini if GEMINI_API_KEY is set, else anthropic if its key is set)
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Separate, spend-capped key for the live agent process (falls back to the gateway key).
AGENT_GEMINI_API_KEY=
AGENT_ANTHROPIC_API_KEY=
# Groq (free tier): takes over when Gemini is overloaded (D14), or is the only LLM with LLM_PROVIDER=groq.
# Models are tried in order; each has its own per-minute limit on the free tier.
GROQ_API_KEY=
AGENT_GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Number of reverse proxies in front of the app (1 on Render). Leave empty when exposed directly.
TRUST_PROXY_HOPS=
MAX_AGENT_RUNS=3
# PayPal consent: auto (Vault, else a standing hold) | vault | hold. Hold amount in cents (sandbox money).
PAYPAL_CONSENT_MODE=auto
PAYPAL_HOLD_CENTS=200000
